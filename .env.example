# Příklad lokálních hodnot pro docker-compose.yml. Zkopíruj do .env (gitignorovaný) a doplň.
# Jsou to jen placeholdery, skutečné hodnoty do repozitáře nepatří.

# Admini lokální aplikace (prázdné heslo = uživatel se nezaloží).
ADMIN_USER_1=admin1
ADMIN_PASSWORD_1=change-me-local-only
ADMIN_USER_2=
ADMIN_PASSWORD_2=

# Klíč k mapám Mapy.com. Bez klíče se mapa skryje.
MAPY_API_KEY=

# Import ze Stravy (nepovinný): https://www.strava.com/settings/api, Authorization Callback Domain = localhost.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
